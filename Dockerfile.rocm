# Final image: Triton Server (ROCm) + vLLM + vLLM Backend
#
# This Dockerfile extends the tritonserver image built by the ROCm build scripts.
# It is NOT meant to be used standalone — see the GitHub Action workflow which:
#   1. Builds the tritonserver ROCm base via build.py (Docker-in-Docker)
#   2. Extends it with this Dockerfile to add vLLM + the backend
#
# Build args:
#   BASE_IMAGE         - tritonserver image from step 1
#   PYTORCH_ROCM_ARCH  - Target GPU architectures
#   VLLM_VERSION       - vLLM version (e.g., 0.17.1)
#   ROCM_WHEEL_TAG     - ROCm wheel variant tag (e.g., rocm700)

ARG BASE_IMAGE=tritonserver:latest
FROM ${BASE_IMAGE}

ARG PYTORCH_ROCM_ARCH="gfx1201"
ENV PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH}

ARG VLLM_VERSION="0.17.1"
ARG ROCM_WHEEL_TAG="rocm700"

# Install runtime dependencies required by PyTorch ROCm wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopenmpi-dev && \
    rm -rf /var/lib/apt/lists/*

# Install uv (pip 24.0 from Debian can't handle +rocm local version wheels)
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh

ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV UV_BREAK_SYSTEM_PACKAGES=true

# Install vLLM ROCm build from official AMD/vLLM wheel index
# Pre-built wheels include torch, triton, flash-attn compiled for ROCm
RUN uv pip install --system --no-cache \
    "vllm==${VLLM_VERSION}+${ROCM_WHEEL_TAG}" \
    --extra-index-url "https://wheels.vllm.ai/rocm/${VLLM_VERSION}/${ROCM_WHEEL_TAG}" && \
    uv pip install --system --no-cache \
    huggingface-hub[cli] \
    pillow \
    numpy

# Copy vLLM backend into Triton backends directory
COPY src/ /opt/tritonserver/backends/vllm/

ENV MODEL_REPOSITORY=/models

EXPOSE 8000 8001 8002

ENTRYPOINT ["tritonserver"]
CMD ["--model-repository=/models"]
